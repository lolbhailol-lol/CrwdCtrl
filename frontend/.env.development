# Development Environment Configuration for CrwdCtrl

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=CrwdCtrl (Dev)
VITE_APP_VERSION=1.0.0-dev
VITE_APP_ENVIRONMENT=development

# Authentication
VITE_JWT_TOKEN_KEY=crwdctrl_token_dev
VITE_SESSION_TIMEOUT=86400000

# Feature Flags (Enable all features in development)
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_FAVORITES=true

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination
VITE_DEFAULT_PAGE_SIZE=5
VITE_MAX_PAGE_SIZE=25

# Search Configuration
VITE_MIN_SEARCH_LENGTH=2
VITE_SEARCH_DEBOUNCE_TIME=100

# Location Configuration
VITE_DEFAULT_LATITUDE=28.6139
VITE_DEFAULT_LONGITUDE=77.2090

# Social Media (Leave empty for development)
VITE_FACEBOOK_APP_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_TWITTER_API_KEY=

# Analytics (Leave empty for development)
VITE_GOOGLE_ANALYTICS_ID=
VITE_HOTJAR_ID=

# Error Tracking (Leave empty for development)
VITE_SENTRY_DSN=

# Cache Configuration (Shorter cache times for development)
VITE_CACHE_DURATION=60000
VITE_IMAGE_CACHE_DURATION=300000
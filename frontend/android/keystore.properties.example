# Release signing config for CrwdCtrl Play Store builds.
# Copy to `keystore.properties` (gitignored) and fill in your real values.
# NEVER commit keystore.properties or the .keystore/.jks file.
#
# Generate an upload keystore once:
#   keytool -genkeypair -v -keystore crwdctrl-upload.keystore -alias crwdctrl \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/ project root.

storeFile=crwdctrl-upload.keystore
storePassword=CHANGE_ME
keyAlias=crwdctrl
keyPassword=CHANGE_ME

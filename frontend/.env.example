# Frontend Environment Configuration for CrwdCtrl
# Copy this file to .env and fill in your values
#
# Only VITE_* keys are exposed to the browser bundle. Never put Mongo URI,
# JWT_SECRET, Cashfree secret, Cloudinary secret, or admin hashes here —
# those belong only in backend/.env (or Railway env vars).

# API Configuration — use VITE_API_BASE_URL (not VITE_API_URL)
# Production: https://crwdctrl-production-9c58.up.railway.app/api
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=CrwdCtrl
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Authentication
VITE_JWT_TOKEN_KEY=crwdctrl_token
VITE_SESSION_TIMEOUT=86400000

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_FAVORITES=true
# Campus Hunt competition module (admin sidebar + player routes)
VITE_ENABLE_CAMPUS_HUNT=true
# Set true only for the hunt deploy. Local only — never ship with cheats on:
# VITE_CAMPUS_HUNT_DEV_CHEATS=1

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=50

# Search Configuration
VITE_MIN_SEARCH_LENGTH=3
VITE_SEARCH_DEBOUNCE_TIME=300

# Location Configuration
VITE_DEFAULT_LATITUDE=28.6139
VITE_DEFAULT_LONGITUDE=77.2090

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Social Media
VITE_FACEBOOK_APP_ID=
# Firebase project's Web OAuth client ID. Also powers Google One Tap sign-in.
# Add your site under "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
VITE_TWITTER_API_KEY=

# Analytics & Error Tracking
VITE_GOOGLE_ANALYTICS_ID=
VITE_HOTJAR_ID=
VITE_SENTRY_DSN=
# Firebase Performance Monitoring is on in production by default; set to true to
# also collect real-user perf traces in development.
VITE_ENABLE_PERFORMANCE=

# reCAPTCHA v3 — site key (public). Leave blank to disable captcha entirely.
# Pair with RECAPTCHA_SECRET_KEY on the backend.
VITE_RECAPTCHA_SITE_KEY=

# Cache Configuration
VITE_CACHE_DURATION=600000
VITE_IMAGE_CACHE_DURATION=7200000

# Cashfree — sandbox locally, production on Vercel/Railway
# Local: use frontend/.env.local with VITE_CASHFREE_MODE=sandbox + backend sandbox keys
# Production: VITE_CASHFREE_MODE=production (see .env.production)
VITE_CASHFREE_MODE=sandbox

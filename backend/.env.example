# Backend Environment Configuration for CrwdCtrl
# Copy this file to .env and fill in your values

# =========================
# REQUIRED
# =========================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret-key-change-this

PORT=8080
NODE_ENV=development

# =========================
# PRODUCTION — Railway dashboard
# =========================

# Admin dashboard login (email + bcrypt hash in production)
ADMIN_EMAIL=
# ADMIN_PASSWORD=  # dev only — use ADMIN_PASSWORD_HASH in production

# Cashfree Payments (must match frontend VITE_CASHFREE_MODE)
# Sandbox: create keys at https://sandbox.cashfree.com → Developers → API Keys
# Copy backend/.env.local.example → backend/.env for local dev (never commit real keys)
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Admin password — use hash in production (run: node scripts/hash-admin-password.js)
ADMIN_PASSWORD_HASH=

# Optional: public site URL for emails/links
FRONTEND_URL=http://localhost:5173

# Comma-separated extra CORS origins (preview deploys, staging).
# CrwdCtrl Vercel preview URLs (crwd-ctrl-*-crwdctrls-projects.vercel.app) are allowed in code automatically.
# CORS_EXTRA_ORIGINS=https://my-preview.vercel.app

# Keep-alive ping target (must be the live Railway public domain)
# RAILWAY_KEEP_ALIVE_URL=https://crwdctrl-production-9c58.up.railway.app

# Error monitoring (optional but recommended in production)
SENTRY_DSN=

# reCAPTCHA v3 — secret key (server-side). Leave blank to disable captcha
# verification entirely (login/register then work without a captcha).
# Pair with VITE_RECAPTCHA_SITE_KEY on the frontend.
RECAPTCHA_SECRET_KEY=
# Reject requests scoring below this (0.0–1.0). Default 0.5.
RECAPTCHA_MIN_SCORE=0.5

# =========================
# OPTIONAL FEATURES
# =========================

# Campus Hunt competition module (default off — enable for pilot/production deliberately)
CAMPUS_HUNT_ENABLED=false
# 32+ random characters; changing this after credentials are created requires rotating team passwords.
CAMPUS_HUNT_CREDENTIAL_KEY=
# Player JWT lifetime (team enter + session refresh). Keep ≥ 1d for event day.
# USER_JWT_EXPIRES_IN=30d
# JWT_EXPIRES_IN=30d
# CAMPUS_HUNT_LOGIN_RATE_LIMIT_MAX=20
# CAMPUS_HUNT_VERIFY_RATE_LIMIT_MAX=600
# Local/staging only — enables player “Dev: scan all 4 & continue”. Never set in production.
# CAMPUS_HUNT_DEV_CHEATS=1


# Cloudinary (file/image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (preferred)
RESEND_API_KEY=
RESEND_FROM=CrwdCtrl <noreply@crwdctrl.in>
# Webhook signing secret from Resend (Webhooks → endpoint → signing secret)
RESEND_WEBHOOK_SECRET=

# Email — Gmail SMTP (fallback)
EMAIL_USER=
EMAIL_PASS=

# Google Sheets (registration sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Push notifications — set KEY on Railway (required for FCM push). PATH is optional fallback.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional local file fallback (not needed if KEY is set):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Verify: node scripts/verify-firebase-admin.js

# Run-club participant PII encryption (AES-256-GCM). Prefer a dedicated 32+ char secret.
# If unset, JWT_SECRET is used as fallback. Changing this key makes existing ciphertext unreadable.
RUN_CLUB_PII_MASTER_KEY=

# Pending organizer-QR payments never auto-expire (hard-disabled in code).
# Manual "Clear old pending" button TTL on organizer dashboard (default 72h).
# RUN_QR_MANUAL_EXPIRE_TTL_HOURS=72
# Extra hosts allowed for payment screenshot URLs (comma-separated), beyond Cloudinary.
# PAYMENT_SCREENSHOT_ALLOWED_HOSTS=

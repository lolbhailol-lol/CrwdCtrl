# Backend Environment Configuration for CrwdCtrl
# Copy this file to .env and fill in your values

# =========================
# REQUIRED - Server will fail without these
# =========================

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret for authentication tokens (use a long random string)
JWT_SECRET=your-jwt-secret-key-change-this

# Server Configuration
PORT=8080
NODE_ENV=development

# =========================
# OPTIONAL - Features that need these
# =========================

# Cloudinary (for file/image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email - Resend (preferred for production)
RESEND_API_KEY=

# Email - Gmail SMTP (fallback)
EMAIL_USER=
EMAIL_PASS=

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Railway Deployment
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=
# RAILWAY_KEEP_ALIVE_URL=

# Admin Authentication
# ADMIN_REFRESH_SECRET=your-admin-refresh-secret

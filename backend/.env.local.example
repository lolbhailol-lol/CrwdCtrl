# Copy into backend/.env for local Cashfree sandbox payments (gitignored — do not commit real keys)
# Dashboard: https://sandbox.cashfree.com/merchant/login → Developers → API Keys
# Whitelist: Developers → Whitelisting → add http://localhost:5173
#
# Two merchants:
#   CASHFREE_*         = platform (fests, sports clubs)
#   CASHFREE_EVENTS_*  = Delulu Athletes / event communities only
# Production (Railway): set CASHFREE_ENV=production + live platform keys,
# and CASHFREE_EVENTS_ENV=production + live Delulu/events keys.

FRONTEND_URL=http://localhost:5173

CASHFREE_CLIENT_ID=your_platform_sandbox_client_id
CASHFREE_CLIENT_SECRET=your_platform_sandbox_client_secret
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

CASHFREE_EVENTS_CLIENT_ID=your_events_sandbox_client_id
CASHFREE_EVENTS_CLIENT_SECRET=your_events_sandbox_client_secret
CASHFREE_EVENTS_ENV=sandbox

# TrekVede / organizer Razorpay (test keys from Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Verify platform: node scripts/test-cashfree.js
# Verify events:   node -e "require('dotenv').config(); require('./src/services/cashfreeService').createCashfreeOrder({orderAmount:10,customerDetails:{customerId:'t',customerEmail:'t@t.com',customerPhone:'9999999999'},merchant:'events'}).then(o=>console.log(o.order_id,o.cashfreeMerchant)).catch(e=>console.error(e.response?.data||e.message))"
